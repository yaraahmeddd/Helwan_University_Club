# ─── قاعدة البيانات ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=Helwan-University-Club

# ─── السيرفر ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────
# اتركها فاضية للـ dev المحلي. ضع الدومينات المسموحة في production.
# مثال: ALLOWED_ORIGINS=https://club.example.com,https://www.club.example.com
ALLOWED_ORIGINS=

# ─── JWT ──────────────────────────────────────────────────────────
# مهم: غيّر JWT_SECRET لقيمة عشوائية قوية!
# توليد قيمة آمنة:  openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_RANDOM_32_BYTE_BASE64_STRING
JWT_EXPIRES_IN=7d

# AI Chatbot
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_API_KEY

# ─── TypeORM ──────────────────────────────────────────────────────
TYPEORM_LOGGING=false
TYPEORM_SYNCHRONIZE=false

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info
