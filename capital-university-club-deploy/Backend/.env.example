# ─── قاعدة البيانات ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=Helwan-University-Club

# ─── السيرفر ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── CORS ─────────────────────────────────────────────────────────
# اتركها فاضية للـ dev المحلي. ضع الدومينات المسموحة في production.
# مثال: ALLOWED_ORIGINS=https://club.example.com,https://www.club.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── JWT ──────────────────────────────────────────────────────────
# مهم: غيّر JWT_SECRET لقيمة عشوائية قوية!
# توليد قيمة آمنة:  openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_RANDOM_32_BYTE_BASE64_STRING
JWT_EXPIRES_IN=7d

# ─── TypeORM ──────────────────────────────────────────────────────
TYPEORM_LOGGING=false
TYPEORM_SYNCHRONIZE=false

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info
DEBUG_AUTH=false

# ─── Google Gemini AI (اختياري — الشات بوت) ─────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ─── Paymob — بوابة الدفع (اختياري) ───────────────────────────────
# https://accept.paymob.com/
PAYMOB_API_KEY=YOUR_PAYMOB_API_KEY
PAYMOB_INTEGRATION_ID=YOUR_INTEGRATION_ID
PAYMOB_IFRAME_ID=1011824

# ─── Cloudinary — رفع صور (اختياري — البديل: Backend/uploads/) ────
# https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Migrations script only (optional connection string) ──────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/Helwan-University-Club
